---
import Layout from '../../layouts/Layout.astro';
import NexosJuego from '../../components/minijuegos/nexos/NexosJuego';
---

<Layout titulo="Nexos - FutPerú">
    <main>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 contenedor-titulo-calculadora">
                    <div class="row gx-0 justify-content-center align-items-center">
                        <div class="col-6">
                            <h1 class="text-center titulo-calculadora">MINIJUEGO "NEXOS"</h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <NexosJuego client:load />
    </main>
</Layout>

<style>
    main {
        min-height: 100vh;
        background: #0f1923;
    }
</style>
