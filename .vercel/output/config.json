{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/calculadora/?$",
			"dest": "_render"
		},
		{
			"src": "^/copa-liga/?$",
			"dest": "_render"
		},
		{
			"src": "^/equipos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/equipos/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/abc/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/el-once/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/el-once-actualidad/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/el-once-leyendas/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/el-tapadito/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/nexos/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/subeybaja/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/top-goleadores/?$",
			"dest": "_render"
		},
		{
			"src": "^/minijuegos/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}