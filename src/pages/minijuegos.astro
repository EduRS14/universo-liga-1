---
import Layout from '../layouts/Layout.astro';
---

<Layout>

    <main>

        <div class="container-fluid">
	    	<div class="row">

                <div class="col-12 contenedor-titulo-calculadora">
                    <div class="row gx-0 justify-content-center align-items-center">
                        <div class="col-6">
                            <h1 class="text-center titulo-calculadora">FUTPERÚ</h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
        	<div class="row justify-content-center align-items-center">
                <div class="col-8 contenedor-subtitulo-futperu">
                    <h2 class="text-center subtitulo-futperu">Minijuegos del Fútbol Peruano</h2>
                </div>
                <div class="col-10 col-lg-6 contenedor-descripcion-futperu">
                    <p class="text-center descripcion-futperu">¡Diviértete con nuestros minijuegos inspirados en el fútbol peruano! Pon a prueba tus conocimientos en diferentes retos que involucran a los jugadores y clubes que pasaron por la Primera División de Perú entre los años 2010 y 2026. ¡Juega ahora y demuestra que eres el mejor fanático del fútbol peruano!</p>
                </div>
            </div>
        </div>

        <div class="container-fluid">
        	<div class="row justify-content-center align-items-center">
                <div class="col-8 contenedor-subtitulo-futperu">
                    <h3 class="text-center texto-seleccion">Selecciona el juego que desees jugar</h3>
                </div>
            </div>
        </div>

        <div class="container-fluid contenedor-minijuegos">
        	<div class="row justify-content-center align-items-center">

                <div class="col-11 col-lg-8">

                    <div class="row justify-content-center align-items-center">
                        
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego">
                                <a class="titulo-minijuegos" href="/minijuegos/el-once">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/el-once.webp" alt="El Once" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego">
                                        <h4 class="nombre-juego">EL ONCE</h4>
                                        <p class="descripcion-juego">11 posiciones, cientos de cracks</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego">
                                <a class="titulo-minijuegos" href="/minijuegos/el-once-leyendas">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/el-once-leyendas.webp" alt="El Once Leyendas" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego">
                                        <h4 class="nombre-juego">EL ONCE - LEYENDAS</h4>
                                        <p class="descripcion-juego">11 posiciones, solo leyendas</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego">
                                <a class="titulo-minijuegos" href="/minijuegos/el-once-actualidad">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/el-once-actualidad.webp" alt="El Once Actualidad" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego">
                                        <h4 class="nombre-juego">EL ONCE - ACTUALIDAD</h4>
                                        <p class="descripcion-juego">11 posiciones, los cracks de hoy</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego">
                                <a class="titulo-minijuegos" href="/minijuegos/abc">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/el-abc.webp" alt="El ABC" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego">
                                        <h4 class="nombre-juego">EL ABC</h4>
                                        <p class="descripcion-juego">El diccionario del hincha</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego">
                                <a class="titulo-minijuegos" href="/minijuegos/top-goleadores">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/top-goleadores.webp" alt="El Top: Goleadores" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego">
                                        <h4 class="nombre-juego">EL TOP: GOLEADORES</h4>
                                        <p class="descripcion-juego">La memoria del gol</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego">
                                <a class="titulo-minijuegos" href="/minijuegos/el-tapadito">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/el-tapadito.webp" alt="El Tapadito" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego">
                                        <h4 class="nombre-juego">EL TAPADITO</h4>
                                        <p class="descripcion-juego">El Wordle de la Liga 1</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego-proximamente">
                                <a class="titulo-minijuegos">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/proximamente.webp" alt="El Once" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego-proximamente">
                                        <h4 class="nombre-juego nombre-proximamente">PRÓXIMAMENTE</h4>
                                        <p class="descripcion-juego descripcion-proximamnte">Calentando en la banca</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego-proximamente">
                                <a class="titulo-minijuegos">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/proximamente.webp" alt="El Once" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego-proximamente">
                                        <h4 class="nombre-juego nombre-proximamente">PRÓXIMAMENTE</h4>
                                        <p class="descripcion-juego descripcion-proximamnte">Calentando en la banca</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-4 text-center d-flex justify-content-center align-items-center p-2">
                            <div class="contenedor-juego-proximamente">
                                <a class="titulo-minijuegos">
                                    <div class="img-wrapper">
                                        <img src="/img/minijuegos/juegos/proximamente.webp" alt="El Once" class="img-fluid img-juego">
                                    </div>
                                    <div class="contenedor-descripcion-juego-proximamente">
                                        <h4 class="nombre-juego nombre-proximamente">PRÓXIMAMENTE</h4>
                                        <p class="descripcion-juego descripcion-proximamnte">Calentando en la banca</p>
                                    </div>
                                </a>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>

    </main>

</Layout>

<style>
    .contenedor-minijuegos {
        margin-top: 2rem;
        margin-bottom: 5rem;
    }

    .contenedor-subtitulo-futperu {
        margin-top: 3rem;
        margin-bottom: 2rem;
    }

    .contenedor-descripcion-futperu {
        margin-bottom: 2rem;
    }

    /* --- TEXTOS REFINADOS --- */
    .subtitulo-futperu {
        color: #ffffff;
        font-size: 2.8rem;
        font-weight: 800;
        font-style: italic;
        text-shadow: 0 4px 10px rgba(0,0,0,0.3); /* Sombra más suave y moderna */
    }

    .descripcion-futperu {
        color: #cbd5e1; /* Gris claro para no cansar la vista */
        margin-top: 1rem;
        font-size: 1.05rem;
        line-height: 1.6; /* Mejor interlineado para lectura fluida */
    }

    .texto-seleccion {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: bold;
        text-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
    }

    /* --- TARJETAS DE JUEGO (Mejora UI/UX) --- */
    .contenedor-juego, .contenedor-juego-proximamente {
        max-width: 250px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        overflow: hidden;
        /* Reducimos de 6px a 3px para mayor elegancia */
        border: 3px solid rgba(239, 68, 68, 0.8); 
        border-radius: 16px; /* Bordes un poco más suaves */
        background-color: #1e293b; /* Fondo oscuro base para la tarjeta */
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3); /* Profundidad */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); /* Animación más profesional */
        margin-bottom: 2.5rem;
    }

    /* Tarjetas bloqueadas */
    .contenedor-juego-proximamente {
        border: 3px solid #475569;
        opacity: 0.65; /* Opacidad para denotar inactividad */
        cursor: not-allowed;
    }
    
    /* Quitamos los eventos de click a los enlaces de "Próximamente" */
    .contenedor-juego-proximamente a {
        pointer-events: none; 
    }

    .contenedor-descripcion-juego, .contenedor-descripcion-juego-proximamente {
        width: 100%; /* Asegura que la caja de texto ocupe todo el ancho */
        padding-top: 1.2rem;
        padding-bottom: 1.5rem;
        background-color: rgba(127, 29, 29, 0.9); /* Rojo oscuro sólido */
        transition: background-color 0.3s ease;
    }

    .contenedor-descripcion-juego-proximamente {
        background-color: #334155; /* Gris pizarra */
    }

    .img-wrapper {
        width: 100%;
        max-width: 250px;
        aspect-ratio: 1 / 1; /* Mantiene el cuadrado perfecto automáticamente */
        overflow: hidden;
    }

    .titulo-minijuegos {
        text-decoration: none;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .img-juego {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .nombre-juego {
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 800;
        font-style: italic;
        margin-bottom: 0.2rem;
    }

    .nombre-proximamente {
        color: #94a3b8;
    }

    .descripcion-juego {
        color: #f1f5f9;
        margin-top: 0;
        font-size: 0.85rem;
    }

    .descripcion-proximamnte {
        color: #64748b;
    }

    /* --- HOVER EFFECTS (Interacción) --- */
    .contenedor-juego:hover {
        transform: translateY(-8px); /* Elevación sutil al pasar el mouse */
        border-color: #8b5cf6; /* Cambia a borde morado moderno */
        box-shadow: 0 15px 30px rgba(139, 92, 246, 0.3); /* Sombra morada */
    }

    .contenedor-juego:hover .img-juego {
        transform: scale(1.08); /* Zoom sutil, menos agresivo que 1.1 */
    }

    .contenedor-juego:hover .contenedor-descripcion-juego {
        background-color: rgba(91, 33, 182, 0.95); /* Fondo de texto morado */
    }

    /* --- RESPONSIVO MÓVIL (Optimizado) --- */
    @media (max-width: 768px) {
        .contenedor-subtitulo-futperu {
            margin: 1.5rem 0;
        }

        .contenedor-descripcion-futperu {
            margin-bottom: 1rem;
        }

        .subtitulo-futperu {
            font-size: 1.6rem;
        }
        
        .descripcion-futperu {
            font-size: 0.85rem;
            margin-top: 0;
            margin-bottom: 1rem;
        }

        .texto-seleccion {
            font-size: 1.1rem;
        }

        .contenedor-juego, .contenedor-juego-proximamente {
            margin-bottom: 1rem;
            border-width: 2px; /* Borde aún más fino en celular */
            border-radius: 12px;
        }

        .img-wrapper {
            width: 100px;
            height: 100px;
        }

        .img-juego {
            width: 100px;
        }

        .contenedor-descripcion-juego, .contenedor-descripcion-juego-proximamente {
            padding: 0.8rem 0.2rem;
            width: 100%;
        }

        .nombre-juego {
            font-size: 0.65rem;
            text-align: center;
        }

        .descripcion-juego {
            font-size: 0.55rem;
            text-align: center;
            max-width: 90px;
            line-height: 1.2;
        }
    }
</style>