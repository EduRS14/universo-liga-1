---
import Layout from '../../layouts/Layout.astro';
import MenuSubeBaja from '../../components/minijuegos/subeybaja/Menu-SubeBaja';
---

<Layout>

    <div class="container-fluid">
	    <div class="row">
            <div class="col-12 contenedor-titulo-calculadora">
                <div class="row gx-0 justify-content-center align-items-center">
                    <div class="col-6">
                        <h1 class="text-center titulo-calculadora">MINIJUEGO "SUBE Y BAJA"</h1>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <MenuSubeBaja client:only="react" />

</Layout>

<style>

    .contenedor-opciones{
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .texto-general{
        font-size: 1.2rem;
        color: rgb(255, 255, 255);
        margin: 2rem;
    }

    .texto-opcion{
        font-size: 1rem;
        color: rgb(255, 255, 255);
        margin-left: 0.5rem;
    }

    .radio-oculto {
      display: none;
    }

    .radio-label {
      display: inline-block;
      padding: 12px 24px;
      font-family: sans-serif;
      font-size: 16px;
      background-color: #f0f0f0;
      color: #333;
      border: 2px solid #ddd;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
    }

    .radio-label:hover {
      background-color: #e2e2e0;
    }

    input[type="radio"]:checked + .radio-label {
      background-color: #3b82f6;
      color: white;
      border-color: #2563eb;
      box-shadow: inset 0 3px 5px rgba(0,0,0,0.2);
      transform: translateY(1px);
    }

</style>
